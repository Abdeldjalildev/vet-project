rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function membershipExists() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function membership() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeMember() {
      return membershipExists() && membership().status == 'active';
    }

    function memberOf(clinicId) {
      return activeMember() && membership().clinicId == clinicId;
    }

    function ownerOrAdmin() {
      return activeMember() &&
        (membership().role == 'owner' || membership().role == 'admin');
    }

    function publicClinic(clinicId) {
      return get(/databases/$(database)/documents/clinics/$(clinicId)).data.public == true;
    }

    function activePublicClinic(clinicId) {
      return publicClinic(clinicId) &&
        get(/databases/$(database)/documents/clinics/$(clinicId)).data.active == true;
    }

    match /clinics/{clinicId} {
      allow read: if resource.data.public == true || memberOf(clinicId);
      allow create: if false;
      allow update, delete: if memberOf(clinicId) && ownerOrAdmin();

      match /services/{serviceId} {
        allow read: if resource.data.active == true || memberOf(clinicId);
        allow create, update, delete: if memberOf(clinicId) && ownerOrAdmin();
      }

      match /faqs/{faqId} {
        allow read: if resource.data.active == true || memberOf(clinicId);
        allow create, update, delete: if memberOf(clinicId) && ownerOrAdmin();
      }

      match /appointments/{appointmentId} {
        allow read: if memberOf(clinicId);
        // Public booking is validated atomically by the trusted Cloud Function.\n        allow create: if false;
        // Appointment writes go through trusted Cloud Functions so lifecycle and conflict rules cannot be bypassed.\n        allow update, delete: if false;
      }

      match /analyticsEvents/{eventId} {
        allow read: if memberOf(clinicId) && ownerOrAdmin();
        allow create, update, delete: if false;
      }

      match /analyticsAggregates/{aggregateId} {
        allow read: if memberOf(clinicId) && ownerOrAdmin();
        allow create, update, delete: if false;
      }
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, delete: if false;
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
