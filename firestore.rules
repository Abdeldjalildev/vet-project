rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function membershipExists() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function membership() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function activeMember() { return membershipExists() && membership().status == 'active'; }
    function memberOf(clinicId) { return activeMember() && (membership().role == 'owner' || membership().role == 'admin') && membership().clinicId == clinicId; }
    function ownerOrAdmin() { return activeMember() && (membership().role == 'owner' || membership().role == 'admin'); }

    function validHttpsUrl(value) {
      return value is string && (value == '' || value.matches('^https://[^ ]+$'));
    }

    function validLocalized(value) {
      return value is map && value.keys().hasOnly(['ar', 'en', 'fr']) &&
        value.ar is string && value.en is string && value.fr is string;
    }

    function validLocalizedIfPresent(data, field) {
      return !(field in data) || validLocalized(data[field]);
    }

    function validBranding() {
      return !('branding' in request.resource.data) || (
        request.resource.data.branding is map &&
        request.resource.data.branding.keys().hasOnly(['primaryColor', 'accentColor']) &&
        request.resource.data.branding.primaryColor is string &&
        request.resource.data.branding.accentColor is string &&
        request.resource.data.branding.primaryColor.matches('^#[0-9A-Fa-f]{6}$') &&
        request.resource.data.branding.accentColor.matches('^#[0-9A-Fa-f]{6}$')
      );
    }

    function validFeature(feature) {
      return feature is map &&
        feature.keys().hasOnly(['id', 'icon', 'title', 'description']) &&
        feature.icon is string &&
        validLocalized(feature.title) &&
        validLocalized(feature.description);
    }

    function validManagedContent() {
      return (!('hero' in request.resource.data) || (
        request.resource.data.hero is map &&
        request.resource.data.hero.keys().hasOnly(['badge', 'title', 'description']) &&
        validLocalized(request.resource.data.hero.badge) &&
        validLocalized(request.resource.data.hero.title) &&
        validLocalized(request.resource.data.hero.description)
      )) &&
      (!('about' in request.resource.data) || (
        request.resource.data.about is map &&
        request.resource.data.about.keys().hasOnly(['title', 'description', 'quote', 'features']) &&
        validLocalized(request.resource.data.about.title) &&
        validLocalized(request.resource.data.about.description) &&
        validLocalized(request.resource.data.about.quote) &&
        request.resource.data.about.features is list &&
        request.resource.data.about.features.size() <= 12 &&
        request.resource.data.about.features.all(feature, validFeature(feature))
      )) &&
      (!('footer' in request.resource.data) || (
        request.resource.data.footer is map &&
        request.resource.data.footer.keys().hasOnly(['about', 'copyright']) &&
        validLocalized(request.resource.data.footer.about) &&
        validLocalized(request.resource.data.footer.copyright)
      ));
    }

    function validClinicPublicConfig() {
      return validLocalizedIfPresent(request.resource.data, 'name') &&
        validLocalizedIfPresent(request.resource.data, 'description') &&
        (!('logoUrl' in request.resource.data) || validHttpsUrl(request.resource.data.logoUrl)) &&
        (!('contact' in request.resource.data) || (
          request.resource.data.contact is map &&
          request.resource.data.contact.keys().hasOnly(['address', 'phone', 'email']) &&
          validLocalized(request.resource.data.contact.address) &&
          request.resource.data.contact.phone is string &&
          request.resource.data.contact.email is string &&
          (request.resource.data.contact.email == '' || request.resource.data.contact.email.matches('^[^ @]+@[^ @]+[.][^ @]+$'))
        )) &&
        (!('openingHours' in request.resource.data) || (\n          request.resource.data.openingHours is map &&\n          request.resource.data.openingHours.keys().hasOnly(['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday']) &&\n          (!('monday' in request.resource.data.openingHours) || request.resource.data.openingHours.monday is string) &&\n          (!('tuesday' in request.resource.data.openingHours) || request.resource.data.openingHours.tuesday is string) &&\n          (!('wednesday' in request.resource.data.openingHours) || request.resource.data.openingHours.wednesday is string) &&\n          (!('thursday' in request.resource.data.openingHours) || request.resource.data.openingHours.thursday is string) &&\n          (!('friday' in request.resource.data.openingHours) || request.resource.data.openingHours.friday is string) &&\n          (!('saturday' in request.resource.data.openingHours) || request.resource.data.openingHours.saturday is string) &&\n          (!('sunday' in request.resource.data.openingHours) || request.resource.data.openingHours.sunday is string)\n        )) &&
        validLocalizedIfPresent(request.resource.data, 'emergencyInformation') &&
        validBranding() &&
        validManagedContent() &&
        (!('socialLinks' in request.resource.data) || (
          request.resource.data.socialLinks is map &&
          request.resource.data.socialLinks.keys().hasOnly(['facebook', 'instagram', 'tiktok', 'youtube', 'whatsapp', 'website']) &&
          validHttpsUrl(request.resource.data.socialLinks.facebook) &&
          validHttpsUrl(request.resource.data.socialLinks.instagram) &&
          validHttpsUrl(request.resource.data.socialLinks.tiktok) &&
          validHttpsUrl(request.resource.data.socialLinks.youtube) &&
          validHttpsUrl(request.resource.data.socialLinks.whatsapp) &&
          validHttpsUrl(request.resource.data.socialLinks.website)
        ));
    }

    function clinicUpdateFieldsAreAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'logoUrl', 'branding', 'contact', 'openingHours', 'emergencyInformation', 'hero', 'about', 'footer', 'socialLinks']);
    }

    function serviceFieldsAreAllowed() {
      return request.resource.data.keys().hasOnly(['name', 'description', 'icon', 'price', 'currency', 'order', 'active']);
    }

    function validService() {
      return validLocalized(request.resource.data.name) &&
        validLocalized(request.resource.data.description) &&
        request.resource.data.icon is string &&
        request.resource.data.price is number && request.resource.data.price >= 0 &&
        request.resource.data.currency is string && request.resource.data.currency.matches('^[A-Z]{3}$') &&
        request.resource.data.order is number &&
        request.resource.data.active is bool;
    }

    function faqFieldsAreAllowed() {
      return request.resource.data.keys().hasOnly(['question', 'answer', 'order', 'active']);
    }

    function validFaq() {
      return validLocalized(request.resource.data.question) &&
        validLocalized(request.resource.data.answer) &&
        request.resource.data.order is number &&
        request.resource.data.active is bool;
    }

    match /clinics/{clinicId} {
      allow read: if (resource.data.public == true && resource.data.active == true) || memberOf(clinicId);
      allow create: if false;
      allow update: if memberOf(clinicId) && ownerOrAdmin() && clinicUpdateFieldsAreAllowed() &&
        request.resource.data.keys().hasOnly(['slug', 'public', 'active', 'name', 'description', 'logoUrl', 'branding', 'contact', 'openingHours', 'emergencyInformation', 'hero', 'about', 'footer', 'socialLinks']) &&
        validClinicPublicConfig();
      allow delete: if false;

      match /services/{serviceId} {
        allow read: if (resource.data.active == true &&
          get(/databases/$(database)/documents/clinics/$(clinicId)).data.public == true &&
          get(/databases/$(database)/documents/clinics/$(clinicId)).data.active == true) || memberOf(clinicId);
        allow create: if memberOf(clinicId) && ownerOrAdmin() && serviceFieldsAreAllowed() && validService();
        allow update: if memberOf(clinicId) && ownerOrAdmin() && serviceFieldsAreAllowed() && validService();
        allow delete: if false;
      }

      match /faqs/{faqId} {
        allow read: if (resource.data.active == true &&
          get(/databases/$(database)/documents/clinics/$(clinicId)).data.public == true &&
          get(/databases/$(database)/documents/clinics/$(clinicId)).data.active == true) || memberOf(clinicId);
        allow create: if memberOf(clinicId) && ownerOrAdmin() && faqFieldsAreAllowed() && validFaq();
        allow update: if memberOf(clinicId) && ownerOrAdmin() && faqFieldsAreAllowed() && validFaq();
        allow delete: if memberOf(clinicId) && ownerOrAdmin();
      }

      match /appointments/{appointmentId} {
        allow read: if memberOf(clinicId);
        allow create: if false;
        allow update, delete: if false;
      }

      match /analyticsEvents/{eventId} {
        allow read: if memberOf(clinicId) && ownerOrAdmin();
        allow create, update, delete: if false;
      }

      match /analyticsAggregates/{aggregateId} {
        allow read: if memberOf(clinicId) && ownerOrAdmin();
        allow create, update, delete: if false;
      }
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, delete: if false;
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
